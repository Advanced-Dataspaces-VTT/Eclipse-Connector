# syntax=docker/dockerfile:1

FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

COPY . .
RUN ./gradlew --no-daemon :launchers:controlplane:verifyServiceDescriptors

FROM eclipse-temurin:21-jre
WORKDIR /app

RUN addgroup --system edc && adduser --system --ingroup edc edc
COPY --from=build /workspace/launchers/controlplane/build/libs/controlplane.jar /app/controlplane.jar

USER edc
ENV EDC_FS_CONFIG=/app/configuration.properties
EXPOSE 8080 8081 8082 8083
ENTRYPOINT ["java", "-jar", "/app/controlplane.jar"]
